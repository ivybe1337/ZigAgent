ZIGGY_PROVIDER=stub
ZIGGY_WORKSPACE=.
ZIGGY_PORT=8787
ZIGGY_MAX_STEPS=10
ZIGGY_THRESHOLD=0.78
ZIGGY_SHELL_ENABLED=false
ZIGGY_SHELL_ALLOWLIST=git,bun,npm,node,cargo,zig,python,python3,pytest,rg,grep,find,ls,pwd,cat,sed,awk

OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5-coder:7b

LMSTUDIO_URL=http://localhost:1234/v1/chat/completions
LMSTUDIO_MODEL=local-model

OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

ZIGGY_REM_ENABLED=true
ZIGGY_REM_MIN_EXPERIENCES=5
ZIGGY_REM_TRAIN_STEPS=50
ZIGGY_REM_PRUNE_RATIO=0.10
